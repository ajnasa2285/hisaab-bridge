# The router: the WhatsApp webhooks, /health and the judge page. No agent's key, no ledger.
[Unit]
Description=Hisaab Bridge router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hisaab-router
Group=hisaab-router
WorkingDirectory=/opt/hisaab-bridge
EnvironmentFile=/etc/hisaab/router.env
ExecStart=/usr/bin/node src/service/router.js
Restart=on-failure
RestartSec=5
MemoryHigh=150M
MemoryMax=250M

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hisaab-router
InaccessiblePaths=-/var/lib/hisaab
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
