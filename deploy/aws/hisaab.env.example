# Hisaab Bridge settings. setup.sh copies this to /etc/hisaab/hisaab.env (mode 600) only if that
# file does not exist yet. Fill the empty values on the server with: sudo nano /etc/hisaab/hisaab.env
# Never put real values in this example file or anywhere in the repository.

# Folder for the ledgers, keys and people.json (private to the hisaab user).
HB_DATA_DIR=/var/lib/hisaab
# Public address of this service, like https://203-0-113-10.sslip.io (no trailing slash). setup.sh fills it in.
HB_BASE_URL=
# Local port the service listens on; Caddy forwards to it.
HB_PORT=8080
# Address the service listens on. Keep 127.0.0.1 so only Caddy on this machine can reach it.
HB_HOST=127.0.0.1
# Agent names inside the A2A protocol (keep the defaults unless you know why).
HB_JCB_AGENT_ID=agent:jcb-1
HB_CONTRACTOR_AGENT_ID=agent:contractor-1
# Bearer token for the judge-page export of the ledgers. Leave empty to switch the export off.
HB_EXPORT_TOKEN=
# WhatsApp Graph API version, like v21.0. Leave empty for the built-in default.
HB_WA_GRAPH_VERSION=

# WhatsApp test number 1 (the JCB owner line): its phone number ID from the Meta app dashboard.
HB_WA_JCB_PHONE_NUMBER_ID=
# App secret of the Meta app (checks that webhook calls really come from Meta).
HB_WA_JCB_APP_SECRET=
# Verify token: any long random text you invent; type the same text into the webhook setup in Meta.
HB_WA_JCB_VERIFY_TOKEN=
# Access token that lets the service send WhatsApp messages from this number.
HB_WA_JCB_ACCESS_TOKEN=

# WhatsApp test number 2 (the site / contractor line): its phone number ID.
HB_WA_SITE_PHONE_NUMBER_ID=
# App secret of the Meta app for this number.
HB_WA_SITE_APP_SECRET=
# Verify token for this number's webhook.
HB_WA_SITE_VERIFY_TOKEN=
# Access token for sending from this number.
HB_WA_SITE_ACCESS_TOKEN=

# Meta Model API key (Muse Spark and Muse Voice Transcribe).
META_API_KEY=
# Meta Model API address. Must stay exactly this value.
META_API_BASE=https://api.meta.ai/v1
# Model that reads text and photos.
MUSE_SPARK_MODEL=muse-spark-1.3
# Model that turns voice notes into text.
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
