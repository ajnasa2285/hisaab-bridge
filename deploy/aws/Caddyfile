# Public front door. HB_DOMAIN (and optionally HB_PORT) come from /etc/caddy/hisaab.env,
# written by setup.sh. Caddy gets the HTTPS certificate by itself.
{$HB_DOMAIN} {
	encode zstd gzip

	# A message between agents can carry one evidence photo; the app takes up to 7 MiB
	# (MAX_BODY_BYTES in src/transport/a2a.js), so this cap is just above that.
	@a2a path /agents/*/a2a
	handle @a2a {
		request_body {
			max_size 8MB
		}
		reverse_proxy 127.0.0.1:{$HB_PORT:8080}
	}

	# Webhooks and everything else are small; refuse anything bigger than 1 MB.
	# The judge page imports the pure ledger modules the app serves (src/app.js); nothing else under /src.
	@app path /wa/* /agents/* /health /judge /judge/* /src/ledger/payments.js /src/ledger/usual.js /src/ledger/cross-check.js
	handle @app {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:{$HB_PORT:8080}
	}

	# Everything else: not found. No file server, so no directory listing.
	handle {
		respond "Not found" 404
	}
}
